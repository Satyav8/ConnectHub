{
  "id": "/",
  "name": "ConnectHub",
  "short_name": "ConnectHub",
  "description": "Neon-lit real-time chat rooms and direct messages.",
  "start_url": "/chat",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d0d0d",
